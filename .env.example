# Server
PORT=8443
HOST=0.0.0.0
NODE_ENV=development

# Workspace
WORKSPACE_ROOT=C:\Workspace

# Auth - set PASSWORD_HASH using `pnpm hash-password` (do NOT commit the .env)
PASSWORD_HASH=
SESSION_SECRET=change-me-to-a-long-random-string

# Claude Code CLI binary
CLAUDE_CMD=claude

# Terminal shell (auto-detected if blank; on Windows: pwsh.exe / powershell.exe / cmd.exe)
TERMINAL_SHELL=

# TLS - leave blank to run HTTP in dev (NOT recommended outside loopback). Otherwise paths to PEM files.
TLS_CERT=./certs/cert.pem
TLS_KEY=./certs/key.pem

# Sessions
SESSION_TTL_DAYS=30
PTY_IDLE_TIMEOUT_MS=3600000

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
